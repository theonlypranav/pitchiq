# Path to the SQLite database built by scripts/build_top_scorers.py
APP_DB_PATH=data/app.db
# TTL for the /api/scorers cache in seconds (0 disables caching)
CACHE_TTL_SECONDS=86400
# Requests per minute per client IP on /api/* (burst size = this, refill = this/60 per second; 0 disables)
RATE_LIMIT_PER_MINUTE=30
